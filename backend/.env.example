# Copie este arquivo para .env e ajuste os valores
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:4200

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=nespresso_coletivo

# Use uma string longa e aleatoria (ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio
JWT_EXPIRES_IN=8h

# URL publica do frontend (usada nos links de confirmacao e recuperacao de senha)
FRONTEND_URL=http://localhost:5173

# Opcional: ID do cliente OAuth do Google (xxxx.apps.googleusercontent.com) para botao "Continuar com o Google"
GOOGLE_CLIENT_ID=

# Opcional: URL do Banco de Contas compartilhado (Studios Melk Auth) para compartilhar login/senha entre sites
# Ex.: mysql://root:senha@host:porta/railway
AUTH_DATABASE_URL=

# Recomendado no Railway (HTTPS porta 443, nunca bloqueado): chave de API da Brevo (Chaves API e MCP)
BREVO_API_KEY=

# Ou configuracao SMTP tradicional. Se ambos ficarem vazios, os links sao exibidos no terminal do backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cafezinho Infor <no-reply@cafezinhoinfor.com.br>"
